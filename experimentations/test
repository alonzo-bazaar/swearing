#!/usr/bin/env bash

# Test the output of our homebrewed bqn searching algorithm against a baseline
# (the baseline is ripgrep)

[[ -v DEBUG ]] && set -x

fatal() {
    echo "[FATAL ERROR]: $*" >&2;
    exit 1;
}

SCRIPT_DIR="$(dirname "$0")"
WORDLIST_FILE="${SCRIPT_DIR}/wordlist"

[[ -v TEST ]] || TEST=httpd
TEST_HAYSTACK=
TEST_PATTERN=

POSSIBLE_TESTS=( kjv unicode adv-file adv-dir httpd linux )
case "${TEST}" in
    kjv)      TEST_HAYSTACK="${SCRIPT_DIR}/data/kjv.txt"
              TEST_PATTERN=
              ;;
    unicode)  TEST_HAYSTACK="${SCRIPT_DIR}/data/file-with-unicode.txt"
              TEST_PATTERN=
              ;;
    adv-file) TEST_HAYSTACK="${SCRIPT_DIR}/data/adversarial.txt"
              TEST_PATTERN=
              ;;
    adv-dir)  TEST_HAYSTACK="${SCRIPT_DIR}/data/adversarial/"
              TEST_PATTERN=
              ;;
    httpd)    TEST_HAYSTACK="${SCRIPT_DIR}/data/httpd/"
              TEST_PATTERN='*.[ch]'
              ;;
    linux)    TEST_HAYSTACK="${SCRIPT_DIR}/data/linux/"
              TEST_PATTERN='*.[ch]'
              ;;
esac
cd "${SCRIPT_DIR}" || fatal "could not cd into script dir ${SCRIPT_DIR}!"

baseline() {
    if [[ -n "${TEST_PATTERN}" ]]; then
        ./ohboi.pl "${WORDLIST_FILE}" "${TEST_HAYSTACK}" "${TEST_PATTERN}"
    else
        ./ohboi.pl "${WORDLIST_FILE}" "${TEST_HAYSTACK}"
    fi
}

under-test() {
    if [[ -n "${TEST_PATTERN}" ]]; then
        ./rast/target/release/rast "${WORDLIST_FILE}" "${TEST_HAYSTACK}" "${TEST_PATTERN}"
    else
        ./rast/target/release/rast "${WORDLIST_FILE}" "${TEST_HAYSTACK}"
    fi
}

old--under-test() {
    # we do no globbing in the bqn script, that's better left off to find
    if [[ -f "${TEST_HAYSTACK}" ]]; then
        ./ohdzaima.bqn "${WORDLIST_FILE}" "${TEST_HAYSTACK}"
    else
        if [[ -n "${TEST_PATTERN}" ]]; then
            find "${TEST_HAYSTACK}" -type f -name "${TEST_PATTERN}" -print0 |\
                ./ohdzaima.bqn "${WORDLIST_FILE}"
        else
            find "${TEST_HAYSTACK}" -type f -print0 |\
                ./ohdzaima.bqn "${WORDLIST_FILE}"
        fi
    fi
}

cleanup() {
    [[ -f bl_out ]] && rm bl_out
    [[ -f ut_out ]] && rm ut_out
}

run-test() {
    baseline   > bl_out
    under-test > ut_out
    diff bl_out ut_out || echo "test failed :("
}

main() {
    # prevent any eventual leftover output from last iteration from polluting the
    # environment in which this iteration is gonna run
    cleanup

    # do the damn thing
    run-test

    # I'm commenting this out so I can better inspect the output in case it fails
    # cleanup
}

main "$@"
